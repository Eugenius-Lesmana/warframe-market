{
  "name": "tenno-market",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Warframe.market price intelligence desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node --test tests/test_sniper.cjs tests/test_market.cjs",
    "package": "npm run build && electron-builder --dir --win --config.directories.output=builds/latest && tar -a -c -f builds/latest\\Tenno-Market-Windows.zip -C builds/latest\\win-unpacked ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.eugen.tennomarket",
    "productName": "Tenno Market",
    "directories": {
      "output": "builds/latest"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ]
  }
}
